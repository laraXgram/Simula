{
  "name": "simula",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "tools/*",
    "packages/*"
  ],
  "scripts": {
    "codegen": "bun tools/codegen/src/cli.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tools/codegen --noEmit && tsc -p packages/schema --noEmit && tsc -p apps/web --noEmit",
    "web": "bun --cwd apps/web run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
