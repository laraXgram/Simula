{
  "//": "Manual corrections applied on top of the scraped docs. Every key must match the spec; stale entries fail the build.",
  "all_fields": {
    "parse_mode": {
      "constraints": { "enum": ["HTML", "Markdown", "MarkdownV2"] },
      "handler_validates": true
    },
    "style": { "handler_validates": true },
    "message_ids": {
      "//": "telegram-bot-api's get_message_ids reports its own errors.",
      "handler_validates": true
    }
  },
  "methods": {
    "answerCallbackQuery": {
      "params": { "text": { "//": "The server answers MESSAGE_TOO_LONG.", "handler_validates": true } }
    },
    "setMyCommands": {
      "params": { "commands": { "//": "The server answers BOT_COMMANDS_TOO_MUCH.", "handler_validates": true } }
    },
    "createForumTopic": {
      "params": { "name": { "//": "tdlib cuts names to 128 characters; empty ones get its own error.", "handler_validates": true } }
    },
    "editForumTopic": {
      "params": { "name": { "//": "As for createForumTopic; an empty name means no change.", "handler_validates": true } }
    },
    "editGeneralForumTopic": {
      "params": { "name": { "//": "As for createForumTopic.", "handler_validates": true } }
    },
    "setWebhook": {
      "//": "telegram-bot-api clamps max_connections and checks the secret token itself.",
      "params": {
        "max_connections": { "handler_validates": true },
        "secret_token": { "handler_validates": true }
      }
    }
  },
  "types": {
    "Dice": {
      "fields": { "value": { "constraints": { "range": { "min": 1, "max": 64 } } } }
    },
    "BusinessOpeningHoursInterval": {
      "fields": {
        "opening_minute": { "constraints": { "range": { "min": 0, "max": 10080 } } },
        "closing_minute": { "constraints": { "range": { "min": 0, "max": 11520 } } }
      }
    },
    "KeyboardButton": { "string_shorthand": "text" },
    "BotCommand": {
      "//": "tdlib trims and checks commands with its own texts; the server checks characters.",
      "fields": {
        "command": { "handler_validates": true },
        "description": { "handler_validates": true }
      }
    },
    "InlineKeyboardButton": {
      "//": "The server checks it: BUTTON_DATA_INVALID, not a generic length error.",
      "fields": { "callback_data": { "handler_validates": true } }
    }
  }
}
